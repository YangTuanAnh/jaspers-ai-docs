// SOPHIA — Your Intelligent Market Mind
// Database Schema (DBML) v2.0
// Aligned with PRD v2.0
// - Novu handles notifications (no notification tables)
// - Portkey handles AI logging (no api_usage_logs table)

Project sophia {
  database_type: 'PostgreSQL'
  Note: '''
    # SOPHIA Database Schema v2.0
    
    Unified investment intelligence platform with:
    - Multi-platform portfolio aggregation
    - AI-powered insights via Claude (Portkey gateway)
    - Multi-channel notifications via Novu
    - On-chain analytics for crypto
  '''
}

// =============================================================================
// ENUMS
// =============================================================================

Enum provider_type {
  brokerage
  exchange
  wallet
}

Enum sync_status {
  pending
  syncing
  success
  error
}

Enum asset_type {
  stock
  etf
  crypto
  token
}

Enum message_role {
  user
  assistant
  system
}

Enum alert_type {
  price_above
  price_below
  percent_change_up
  percent_change_down
  volume_spike
}

Enum alert_condition {
  gt
  lt
  gte
  lte
  eq
}

Enum market_state {
  pre
  regular
  post
  closed
}

Enum sentiment {
  positive
  negative
  neutral
}

Enum event_category {
  auth
  connection
  portfolio
  chat
}

Enum event_status {
  success
  failure
  warning
}

// =============================================================================
// CORE USER TABLES
// =============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Authentication
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  email_verified boolean [default: false]
  email_verified_at timestamptz
  
  // Profile
  first_name varchar(100)
  last_name varchar(100)
  avatar_url varchar(500)
  
  // Preferences
  preferred_currency varchar(3) [default: 'USD', note: 'ISO 4217 currency code']
  timezone varchar(50) [default: 'UTC', note: 'IANA timezone']
  locale varchar(10) [default: 'en-US']
  
  // Two-Factor Authentication
  two_factor_enabled boolean [default: false]
  two_factor_secret varchar(255) [note: 'Encrypted TOTP secret']
  
  // Security
  failed_login_count integer [default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  last_login_ip inet
  
  // Novu Integration
  novu_subscriber_id varchar(255) [note: 'Novu subscriber ID for notifications']
  
  // Status
  is_active boolean [default: true]
  deleted_at timestamptz [note: 'Soft delete']
  
  // Timestamps
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    email
    created_at
    novu_subscriber_id
  }
}

// =============================================================================
// TWO-FACTOR AUTHENTICATION (AUTH-04)
// =============================================================================

Table two_factor_backup_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Backup Code (hashed)
  code_hash varchar(255) [not null, note: 'bcrypt hash of code']
  
  // Status
  is_used boolean [default: false]
  used_at timestamptz
  used_ip inet
  
  // Timestamps
  created_at timestamptz [default: `now()`]
  expires_at timestamptz [note: 'Optional expiration']

  indexes {
    user_id
    (user_id, is_used)
    (user_id, code_hash) [unique]
  }
  
  Note: 'Stores hashed one-time backup codes for 2FA recovery'
}

// =============================================================================
// CONNECTIONS & PORTFOLIO
// =============================================================================

Table connections {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Provider Identification
  provider_type provider_type [not null, note: 'brokerage, exchange, wallet']
  provider_id varchar(50) [not null, note: 'alpaca, coinbase, ethereum, etc.']
  
  // Account Info (for OAuth providers)
  external_account_id varchar(255) [note: "Provider's account ID"]
  account_name varchar(255) [note: 'Display name']
  
  // OAuth Tokens (encrypted)
  access_token_encrypted text
  refresh_token_encrypted text
  token_expires_at timestamptz
  token_scope varchar(500) [note: 'OAuth scopes granted']
  
  // Wallet-specific (for blockchain wallets)
  wallet_address varchar(255) [note: 'Public address']
  chain varchar(20) [note: 'ethereum, bitcoin, solana']
  
  // Sync Status
  is_active boolean [default: true]
  sync_status sync_status [default: 'pending']
  sync_error_message text
  last_sync_at timestamptz
  last_successful_sync_at timestamptz
  sync_frequency_minutes integer [default: 5]
  
  // Metadata
  metadata jsonb [default: '{}', note: 'Provider-specific data']
  
  // Timestamps
  connected_at timestamptz [default: `now()`]
  disconnected_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    user_id
    (provider_type, provider_id)
    sync_status
    last_sync_at
    (user_id, provider_type, provider_id) [unique]
  }
}

Table holdings {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Keys
  user_id uuid [not null, ref: > users.id]
  connection_id uuid [not null, ref: > connections.id]
  
  // Asset Identification
  asset_type asset_type [not null, note: 'stock, etf, crypto, token']
  symbol varchar(20) [not null, note: 'Ticker symbol (AAPL, BTC, ETH)']
  name varchar(255) [note: 'Full name (Apple Inc., Bitcoin)']
  
  // For crypto tokens
  contract_address varchar(255) [note: 'Token contract address']
  chain varchar(20) [note: 'Blockchain (ethereum, solana, etc.)']
  decimals integer [note: 'Token decimals']
  
  // Position Details
  quantity decimal(30,18) [not null, note: 'High precision for crypto']
  avg_cost_basis decimal(20,8) [note: 'Average cost per unit']
  
  // Current Valuation (updated by scraper)
  current_price decimal(20,8)
  market_value decimal(20,4) [note: 'quantity * current_price']
  cost_basis_total decimal(20,4) [note: 'quantity * avg_cost_basis']
  
  // P&L Calculations
  unrealized_pl decimal(20,4) [note: 'market_value - cost_basis_total']
  unrealized_pl_percent decimal(10,4) [note: '(unrealized_pl / cost_basis_total) * 100']
  day_pl decimal(20,4) [note: "Today's P&L"]
  day_pl_percent decimal(10,4)
  
  // Source Data
  source_position_id varchar(255) [note: "Provider's position ID"]
  last_synced_at timestamptz
  
  // Timestamps
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    user_id
    connection_id
    symbol
    asset_type
    (user_id, symbol)
  }
}

Table portfolio_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Snapshot Date
  snapshot_date date [not null]
  snapshot_time timestamptz [not null]
  
  // Portfolio Values
  total_value decimal(20,4) [not null]
  cash_balance decimal(20,4) [default: 0]
  invested_value decimal(20,4) [note: 'total_value - cash_balance']
  
  // P&L
  total_cost_basis decimal(20,4)
  total_unrealized_pl decimal(20,4)
  day_pl decimal(20,4)
  day_pl_percent decimal(10,4)
  
  // Breakdown
  stocks_value decimal(20,4) [default: 0]
  crypto_value decimal(20,4) [default: 0]
  
  // Holdings Count
  holdings_count integer [default: 0]
  
  // Detailed Holdings (JSON snapshot)
  holdings_snapshot jsonb [note: 'Array of holdings at this point']
  
  // Timestamps
  created_at timestamptz [default: `now()`]

  indexes {
    (user_id, snapshot_date) [unique]
    snapshot_date
  }
}

// =============================================================================
// AI CHAT (Logging via Portkey)
// =============================================================================

Table chat_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Session Info
  title varchar(255) [note: 'Auto-generated or user-defined']
  
  // Status
  is_archived boolean [default: false]
  is_pinned boolean [default: false]
  
  // Metadata
  message_count integer [default: 0]
  total_tokens_used integer [default: 0]
  
  // Timestamps
  last_message_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    user_id
    (user_id, updated_at)
  }
}

Table chat_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  session_id uuid [not null, ref: > chat_sessions.id]
  
  // Message Content
  role message_role [not null, note: 'user, assistant, system']
  content text [not null]
  
  // AI Response Metadata
  citations jsonb [note: 'Array of citation objects']
  tool_calls jsonb [note: 'Array of tool call records']
  
  // Usage Tracking (summary - detailed logs in Portkey)
  model_used varchar(100) [note: 'claude-3-5-sonnet-20241022']
  input_tokens integer
  output_tokens integer
  processing_time_ms integer
  
  // Portkey Integration
  portkey_trace_id varchar(100) [note: 'Link to Portkey trace for debugging']
  
  // Timestamps
  created_at timestamptz [default: `now()`]

  indexes {
    (session_id, created_at)
    portkey_trace_id
  }

  Note: '''
    AI API logs (detailed) are stored in Portkey dashboard.
    This table stores summary metrics and trace ID for linking.
    
    citations JSON structure:
    {
      "citations": [
        {
          "index": 1,
          "type": "stock_quote|crypto_quote|onchain|news|filing|portfolio",
          "source": "Yahoo Finance",
          "symbol": "AAPL",
          "url": "https://...",
          "timestamp": "2025-11-27T10:30:00Z",
          "text": "AAPL trading at $175.50"
        }
      ]
    }
  '''
}

// =============================================================================
// WATCHLISTS & ALERTS (Notifications via Novu)
// =============================================================================

Table watchlists {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Watchlist Info
  name varchar(100) [not null]
  description text
  color varchar(7) [note: 'Hex color (#FF5733)']
  icon varchar(50) [note: 'Icon identifier']
  
  // Display Order
  sort_order integer [default: 0]
  
  // Timestamps
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    user_id
  }
}

Table watchlist_items {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  watchlist_id uuid [not null, ref: > watchlists.id]
  
  // Asset Info
  asset_type asset_type [not null, note: 'stock, crypto']
  symbol varchar(20) [not null]
  name varchar(255)
  
  // Notes
  notes text
  target_price decimal(20,8)
  
  // Display Order
  sort_order integer [default: 0]
  
  // Timestamps
  added_at timestamptz [default: `now()`]

  indexes {
    watchlist_id
    symbol
    (watchlist_id, asset_type, symbol) [unique]
  }
}

Table alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Foreign Key
  user_id uuid [not null, ref: > users.id]
  
  // Asset Info
  asset_type asset_type [not null, note: 'stock, crypto']
  symbol varchar(20) [not null]
  
  // Alert Configuration
  alert_type alert_type [not null, note: 'price_above, price_below, etc.']
  condition alert_condition [not null, note: 'gt, lt, gte, lte, eq']
  threshold_value decimal(20,8) [not null]
  threshold_unit varchar(10) [default: 'value', note: 'value, percent']
  
  // Notification Settings (delivered via Novu)
  notify_email boolean [default: true]
  notify_push boolean [default: false]
  notify_sms boolean [default: false]
  
  // Status
  is_active boolean [default: true]
  is_repeating boolean [default: false, note: 'Trigger once or multiple times']
  cooldown_minutes integer [default: 60, note: 'Min time between repeated triggers']
  
  // Trigger History
  last_triggered_at timestamptz
  trigger_count integer [default: 0]
  last_checked_price decimal(20,8)
  
  // Timestamps
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  expires_at timestamptz [note: 'Optional expiration']

  indexes {
    user_id
    (is_active, symbol)
    symbol
  }
  
  Note: '''
    When an alert triggers, the backend sends a notification via Novu.
    Novu handles delivery channels (email, push, SMS) and preferences.
    Notification history is stored in Novu dashboard.
  '''
}

// =============================================================================
// MARKET DATA CACHE
// =============================================================================

Table stock_quotes_cache {
  symbol varchar(20) [pk]
  
  // Company Info
  name varchar(255)
  exchange varchar(50)
  
  // Price Data
  price decimal(20,4) [not null]
  open decimal(20,4)
  previous_close decimal(20,4)
  change decimal(20,4)
  change_percent decimal(10,4)
  
  // Day Range
  day_high decimal(20,4)
  day_low decimal(20,4)
  
  // 52 Week Range
  year_high decimal(20,4)
  year_low decimal(20,4)
  
  // Volume & Market Data
  volume bigint
  avg_volume bigint
  market_cap bigint
  
  // Valuation Metrics
  pe_ratio decimal(10,4)
  eps decimal(10,4)
  dividend_yield decimal(10,4)
  beta decimal(10,4)
  
  // Data Source
  data_source varchar(50) [not null, note: 'yahoo_finance, finnhub, polygon']
  
  // Timestamps
  quote_time timestamptz [note: 'When the quote was generated']
  fetched_at timestamptz [default: `now()`]
  
  // Market Status
  market_state market_state [note: 'pre, regular, post, closed']

  indexes {
    fetched_at
  }
}

Table crypto_quotes_cache {
  symbol varchar(20) [pk]
  
  // Identifiers
  coingecko_id varchar(100)
  coinmarketcap_id integer
  name varchar(255)
  
  // Price Data (aligned with CryptoQuoteResponseDTO)
  price decimal(30,18) [not null, note: 'High precision for small-cap coins']
  price_24h_ago decimal(30,18) [note: 'Price 24 hours ago for change calculation']
  price_btc decimal(30,18) [note: 'Price in BTC']
  price_eth decimal(30,18) [note: 'Price in ETH']
  
  // Changes (aligned with CryptoQuoteResponseDTO)
  change_24h decimal(20,4) [note: 'Absolute change in 24h']
  change_percent_24h decimal(10,4) [note: 'Percentage change in 24h']
  change_1h decimal(10,4)
  change_7d decimal(10,4)
  change_30d decimal(10,4)
  
  // Market Data
  market_cap bigint
  market_cap_rank integer
  fully_diluted_valuation bigint
  
  // Volume (aligned with CryptoQuoteResponseDTO)
  volume_24h bigint [note: '24-hour trading volume']
  volume_change_24h decimal(10,4)
  
  // Price Range (aligned with CryptoQuoteResponseDTO)
  high_24h decimal(30,18) [note: '24h high price']
  low_24h decimal(30,18) [note: '24h low price']
  
  // Supply
  circulating_supply decimal(30,8)
  total_supply decimal(30,8)
  max_supply decimal(30,8)
  
  // All-Time Data
  ath decimal(30,18)
  ath_date timestamptz
  ath_change_percent decimal(10,4)
  atl decimal(30,18)
  atl_date timestamptz
  atl_change_percent decimal(10,4)
  
  // Data Source & Timestamps (aligned with CryptoQuoteResponseDTO)
  data_source varchar(50) [not null, note: 'coingecko, binance, coinmarketcap']
  quote_time timestamptz [note: 'When the quote was generated']
  last_updated timestamptz [note: "Provider's last update"]
  fetched_at timestamptz [default: `now()`]

  indexes {
    fetched_at
    coingecko_id
    market_cap_rank
  }
}

// =============================================================================
// ON-CHAIN METRICS CACHE (DATA-06)
// =============================================================================

Table crypto_onchain_cache {
  symbol varchar(20) [pk]
  
  // Chain Info
  chain varchar(20) [not null, note: 'ethereum, bitcoin, solana']
  contract_address varchar(255) [note: 'For tokens']
  
  // Activity Metrics (aligned with OnChainMetricsResponseDTO)
  active_addresses_24h bigint [note: 'Active addresses in last 24h']
  active_addresses_7d bigint
  transaction_count_24h bigint [note: 'Transaction count in last 24h']
  transaction_volume_24h decimal(30,8) [note: 'Transaction volume in native token']
  transaction_volume_usd_24h decimal(20,4) [note: 'Transaction volume in USD']
  
  // Network Metrics
  avg_transaction_fee decimal(20,8) [note: 'Average transaction fee in native token']
  avg_transaction_fee_usd decimal(10,4)
  avg_block_time decimal(10,2) [note: 'Average block time in seconds']
  hashrate decimal(30,4) [note: 'Network hashrate (PoW chains)']
  
  // Holder Distribution (aligned with OnChainMetricsResponseDTO)
  total_holders bigint
  top_10_holders_percent decimal(6,2) [note: 'Top 10 holders percentage']
  top_100_holders_percent decimal(6,2)
  
  // Exchange Flows (aligned with OnChainMetricsResponseDTO)
  exchange_inflow_24h decimal(30,8) [note: 'Exchange inflow in last 24h']
  exchange_outflow_24h decimal(30,8) [note: 'Exchange outflow in last 24h']
  exchange_netflow_24h decimal(30,8) [note: 'Net exchange flow (inflow - outflow)']
  exchange_reserve decimal(30,8) [note: 'Total exchange reserves']
  
  // Whale Activity (aligned with OnChainMetricsResponseDTO)
  whale_transactions_24h integer [note: 'Large transaction count in last 24h']
  whale_volume_24h decimal(30,8) [note: 'Whale transaction volume in last 24h']
  
  // DeFi Metrics (aligned with OnChainMetricsResponseDTO)
  tvl decimal(20,4) [note: 'Total Value Locked in USD (optional)']
  tvl_change_24h decimal(10,4)
  
  // Data Source & Timestamps (aligned with OnChainMetricsResponseDTO)
  data_source varchar(50) [not null, note: 'etherscan, glassnode, blockchain.com, solscan']
  timestamp timestamptz [note: 'Metric timestamp']
  last_updated timestamptz
  fetched_at timestamptz [default: `now()`]

  indexes {
    chain
    fetched_at
  }
  
  Note: 'On-chain analytics data aligned with OnChainMetricsResponseDTO'
}

Table company_profiles_cache {
  symbol varchar(20) [pk]
  
  // Basic Info (aligned with DTOs)
  company_name varchar(255) [note: 'Aligned with DTOs']
  name varchar(255) [note: 'Alias for company_name']
  asset_type asset_type [not null, note: 'stock, crypto']
  
  // Stock-specific
  exchange varchar(50)
  sector varchar(100)
  industry varchar(100)
  ceo varchar(255)
  employees integer
  headquarters varchar(255)
  founded integer [note: 'Year founded']
  country varchar(100) [note: 'Company country']
  currency varchar(3) [note: 'Trading currency']
  ipo_date date [note: 'IPO date']
  
  // Crypto-specific
  categories text[] [note: 'Array of categories']
  platforms jsonb [note: 'Contract addresses per chain']
  
  // Common
  description text
  website varchar(500)
  logo_url varchar(500)
  
  // Data Source & Timestamps
  data_source varchar(50) [not null]
  created_at timestamptz [default: `now()`, note: 'First fetch time']
  updated_at timestamptz [default: `now()`, note: 'Last update time']
  fetched_at timestamptz [default: `now()`]

  indexes {
    asset_type
  }
}

// =============================================================================
// NEWS & FILINGS CACHE
// =============================================================================

Table news_articles {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Article Info (aligned with NewsResponseDTO)
  headline varchar(500) [not null, note: 'Article headline']
  title varchar(500) [not null, note: 'Alias for headline']
  summary text [note: 'Article summary']
  content text [note: 'Full content if available']
  
  // Source (aligned with NewsResponseDTO)
  source varchar(100) [not null, note: 'Source name']
  source_name varchar(100) [not null, note: 'Alias for source']
  source_url varchar(1000) [not null]
  url varchar(1000) [not null, unique, note: 'Article URL']
  
  // Media (aligned with NewsResponseDTO)
  image_url varchar(1000) [note: 'Article image URL']
  
  // Classification (aligned with NewsResponseDTO)
  category varchar(50) [note: 'Article category']
  sentiment sentiment [note: 'positive, negative, neutral']
  sentiment_score decimal(5,4) [note: '-1.0 to 1.0']
  
  // Timestamps (aligned with NewsResponseDTO)
  published_at timestamptz [not null]
  fetched_at timestamptz [default: `now()`]
  data_source varchar(50) [note: 'finnhub, cryptopanic, newsapi']

  indexes {
    published_at
    url
    data_source
  }
}

Table news_article_symbols {
  article_id uuid [ref: > news_articles.id]
  asset_type asset_type [not null]
  symbol varchar(20) [not null]
  
  // Relevance
  is_primary boolean [default: false, note: 'Main subject of article']
  relevance_score decimal(5,4) [note: '0.0 to 1.0']

  indexes {
    (article_id, asset_type, symbol) [pk]
    (symbol, asset_type)
  }
}

Table sec_filings {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Company Identification (aligned with SECFilingResponseDTO)
  cik varchar(20) [not null, note: 'SEC Central Index Key']
  ticker varchar(20) [note: 'Stock ticker symbol']
  symbol varchar(20) [note: 'Alias for ticker']
  company_name varchar(255) [note: 'Company name']
  
  // Filing Info (aligned with SECFilingResponseDTO)
  form_type varchar(20) [not null, note: '10-K, 10-Q, 8-K, etc.']
  description text [note: 'Filing description']
  filing_date date [not null, note: 'Date filed']
  filed_at timestamptz [note: 'Filing timestamp']
  accepted_date timestamptz [note: 'SEC acceptance date']
  report_date date [note: 'Period of report']
  period_of_report date [note: 'Alias for report_date']
  
  // Document References (aligned with SECFilingResponseDTO)
  accession_number varchar(30) [not null, unique, note: 'SEC accession number']
  accession_no varchar(30) [note: 'Alias for accession_number']
  file_number varchar(30)
  
  // URLs (aligned with SECFilingResponseDTO)
  filing_url varchar(500) [not null, note: 'SEC index page URL']
  link_to_filing_details varchar(500) [note: 'Link to filing details']
  link_to_html varchar(500) [note: 'Link to HTML version']
  link_to_xbrl varchar(500) [note: 'Link to XBRL file']
  primary_document_url varchar(500) [note: 'Main document URL']
  primary_document_name varchar(255)
  
  // Content
  extracted_sections jsonb [note: 'Key sections extracted']
  
  // Data Source & Timestamps (aligned with SECFilingResponseDTO)
  data_source varchar(50) [note: 'sec-edgar']
  fetched_at timestamptz [default: `now()`]

  indexes {
    symbol
    ticker
    cik
    form_type
    filing_date
    accession_number [unique]
    accession_no
  }
  
  Note: 'SEC filings aligned with SECFilingResponseDTO'
}

// =============================================================================
// AUDIT LOG (Security events only - AI logs in Portkey, Notifications in Novu)
// =============================================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Actor
  user_id uuid [ref: > users.id]
  
  // Event Info
  event_type varchar(50) [not null, note: 'login, logout, connection_added, etc.']
  event_category event_category [not null, note: 'auth, connection, portfolio, chat']
  
  // Details
  description text
  metadata jsonb [default: '{}']
  
  // Request Context
  ip_address inet
  user_agent varchar(500)
  request_id varchar(100)
  
  // Status
  status event_status [not null, note: 'success, failure, warning']
  error_message text
  
  // Timestamps
  created_at timestamptz [default: `now()`]

  indexes {
    user_id
    event_type
    created_at
  }

  Note: '''
    Security and application audit logs only.
    
    AI API logs → Portkey Dashboard
    Notification logs → Novu Dashboard
    
    Consider partitioning by month for large-scale deployments.
  '''
}

// =============================================================================
// TABLE GROUPS FOR VISUALIZATION
// =============================================================================

TableGroup user_auth {
  users
  two_factor_backup_codes
}

TableGroup portfolio_domain {
  connections
  holdings
  portfolio_snapshots
}

TableGroup chat_domain {
  chat_sessions
  chat_messages
}

TableGroup watchlist_domain {
  watchlists
  watchlist_items
  alerts
}

TableGroup market_data_cache {
  stock_quotes_cache
  crypto_quotes_cache
  crypto_onchain_cache
  company_profiles_cache
}

TableGroup news_cache {
  news_articles
  news_article_symbols
  sec_filings
}

TableGroup audit {
  audit_logs
}

